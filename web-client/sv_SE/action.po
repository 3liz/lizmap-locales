#: action~action.dock.action.choose
msgctxt "action~action.dock.action.choose"
msgid "Choose an action to run"
msgstr "Välj en åtgärd att köra"

#: action~action.dock.close
msgctxt "action~action.dock.close"
msgid "Close"
msgstr "Stäng"

#: action~action.dock.form.button.deactivate.help
msgctxt "action~action.dock.form.button.deactivate.help"
msgid "Deactivate the active action"
msgstr "Inaktivera den aktiva åtgärden"

#: action~action.dock.form.button.deactivate.label
msgctxt "action~action.dock.form.button.deactivate.label"
msgid "Deactivate"
msgstr "Inaktivera"

#: action~action.dock.form.button.run.help
msgctxt "action~action.dock.form.button.run.help"
msgid "Run the selected action"
msgstr "Kör den valda åtgärden"

#: action~action.dock.form.button.run.label
msgctxt "action~action.dock.form.button.run.label"
msgid "Run"
msgstr "Kör"

#: action~action.dock.form.select.emptyItem.label
msgctxt "action~action.dock.form.select.emptyItem.label"
msgid "Choose an action"
msgstr "Välj en åtgärd"

#: action~action.dock.form.select.help
msgctxt "action~action.dock.form.select.help"
msgid "To run an action, select one in the list and click the Run button"
msgstr ""
"För att köra en åtgärd väljer du den i listan och klickar på knappen Kör"

#: action~action.dock.form.select.warning
msgctxt "action~action.dock.form.select.warning"
msgid "You must first select an action in the list"
msgstr "Du måste först välja en åtgärd i listan"

#: action~action.dock.title
msgctxt "action~action.dock.title"
msgid "Actions"
msgstr "Åtgärder"

#: action~action.warning.converted.from.old.configuration
msgctxt "action~action.warning.converted.from.old.configuration"
msgid ""
"Dear administrator, the JSON configuration file for the <b>action module</b>"
" is written in the old format. Please <a target=\"_blank\" href=\"%s\">read "
"the documentation</a> and convert it in the new format, since the old format"
" will not work in the future versions."
msgstr ""
"Administratör: JSON-konfigurationsfilen för <b>åtgärdsmodulen</b> använder "
"det gamla formatet. <a target=\"_blank\" href=\"%s\">Läs dokumentationen</a>"
" och konvertera den till det nya formatet, eftersom det gamla formatet inte "
"kommer att fungera i framtida versioner."
